# ==============================================================================
# SCHOOL MANAGEMENT SYSTEM (SMS) - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env in your root, backend/.env, and frontend/.env.local
# ==============================================================================

# --- Application Meta ---
ENVIRONMENT=development
PROJECT_NAME="School Management System"
DEFAULT_CURRENCY=PKR
DEFAULT_TIMEZONE=Asia/Karachi

# --- Backend API (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Database (Supabase PostgreSQL / Local PostgreSQL / SQLite for Dev) ---
# For Supabase: postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# For Local/Dev testing fallback: sqlite:///./sms_local.db
DATABASE_URL=sqlite:///./sms_dev.db

# --- Supabase Integration ---
# Find these in your Supabase Project Settings -> API & Auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-or-leave-blank-for-jwks
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# --- Development Bypass (Optional for offline dev without Supabase network) ---
ENABLE_DEV_AUTH_BYPASS=false
DEV_ADMIN_EMAIL=admin@schools.pk

# --- Frontend (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
